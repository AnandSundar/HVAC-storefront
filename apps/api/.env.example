# Copy this file to .env and fill in the values for local development.
# In production, set these as env vars in Render (see render.yaml).

# Port the server listens on. Default: 4000
PORT=4000

# One of: development, production. Affects CORS, landing page, CSP.
NODE_ENV=development

# Required for admin mutations (createProduct). If unset, ALL mutations are
# rejected with FORBIDDEN — this is deliberate fail-closed behavior.
# In production, Render generates this automatically (see render.yaml).
ADMIN_TOKEN=

# Allowed CORS origin for the storefront in production. Defaults to localhost:3001
# in development. Set this to your deployed Vercel URL in production.
STOREFRONT_URL=http://localhost:3001