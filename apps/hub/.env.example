# Admin auth token for the /admin routes. Defaults to "test-secret" in dev so
# `pnpm dev` works without setup. In production this MUST be set to a strong
# secret via the Vercel dashboard — the hub fails closed otherwise
# (see apps/hub/src/lib/admin-token-actions.ts).
HUB_ADMIN_TOKEN=test-secret

# Base URL of the Laravel PHP REST API (apps/php-api). Defaults to
# http://localhost:8000 in dev. In production this MUST be https:// — the
# fetcher throws at request time otherwise.
PHP_API_URL=http://localhost:8000
