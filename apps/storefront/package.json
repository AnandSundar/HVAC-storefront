{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "eslintConfig": {
    "extends": "next/core-web-vitals"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next .turbo coverage"
  },
  "dependencies": {
    "@hvac-portfolio/shared-data": "workspace:*",
    "clsx": "^2.1.1",
    "graphql-request": "^7.1.2",
    "graphql": "^16.10.0",
    "lucide-react": "^0.460.0",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.4",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "vitest": {
    "environment": "happy-dom",
    "include": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
    "resolve": {
      "alias": {
        "@": "./src"
      }
    }
  }
}